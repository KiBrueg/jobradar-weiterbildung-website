# JobRadar backend production/deploy settings
JOBRADAR_ADMIN_USER=admin
JOBRADAR_ADMIN_PASSWORD=set_a_strong_password_here
JOBRADAR_PUBLIC_BASE_URL=https://kibrueg.de

# n8n machine access for /api/n8n/* without sharing admin Basic Auth
JOBRADAR_N8N_TOKEN=set_a_random_machine_token_here

# Optional email/n8n notification when a lead is approved for a school
JOBRADAR_APPROVE_NOTIFY_WEBHOOK=https://n8n.example/webhook/jobradar-approve-notify
JOBRADAR_MANUAL_JOB_WEBHOOK=https://n8n.example/webhook/jobradar-manual
# Alternative legacy approve-notification name also supported:
# JOBRADAR_NOTIFY_WEBHOOK_URL=

# Jobradar Postgres
POSTGRES_PASSWORD=
POSTGRES_USER=hub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_JOBRADAR=jobradar
